# ==============================================================================
# ScribaSheet Backend Environment Configuration
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env or expose these secrets to the frontend.
# ==============================================================================

# --- Application ---
APP_NAME=ScribaSheet
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Security & Authentication (Backend-only secrets) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional: Supabase Auth integration (Backend-only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Database ---
# PostgreSQL (Docker / Production):
# DATABASE_URL=postgresql+psycopg://scribasheet:scribasheet@postgres:5432/scribasheet
# SQLite (Local zero-config default):
DATABASE_URL=sqlite:///./scribasheet.db

# --- Background Processing (Celery + Redis) ---
# Set JOB_EXECUTION_MODE=celery when Redis + Celery worker are running.
# Set JOB_EXECUTION_MODE=local to run jobs in a background thread pool without Redis.
JOB_EXECUTION_MODE=local
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
TRANSCRIPTION_TASK_TIMEOUT_SECONDS=600
MAX_CONCURRENT_TRANSCRIPTIONS=2

# --- Object Storage ---
# STORAGE_BACKEND=local | s3 | supabase
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage_data
SIGNED_URL_SECRET=change-me-signed-url-secret
SIGNED_URL_TTL_SECONDS=900

# S3-compatible / Cloudflare R2 / MinIO (when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=scribasheet-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# --- Media & AI ---
MAX_UPLOAD_SIZE_MB=100
MAX_AUDIO_DURATION_SECONDS=900
FFMPEG_BINARY=ffmpeg
ENABLE_SOURCE_SEPARATION=false
SOURCE_SEPARATION_BACKEND=none

# --- Billing (Stripe — Backend-only secrets) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=
